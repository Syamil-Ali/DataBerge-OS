APP_NAME=Data-Berge OS
APP_ENV=local
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
DB_PATH=../data/app.db
DATA_DIR=../data
LOCAL_CACHE_DIR_NAME=cache

# Distributed adapters used by Docker Compose and required in production.
# Leave blank/local for the lightweight python run.py development mode.
DATABASE_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
AUTO_MIGRATE=true
RUN_STARTUP_RECONCILIATION=true
REDIS_URL=
QUEUE_MODE=local
OBJECT_STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=data-berge

# Required in production: generate at least 32 random bytes.
JWT_SECRET=
CONNECTOR_SECRET_KEY=
FEDERATED_CONNECT_TIMEOUT_SECONDS=10
FEDERATED_QUERY_TIMEOUT_MS=15000
FEDERATED_PREVIEW_ROWS=100
FEDERATED_MAX_RESULT_ROWS=500
JWT_ISSUER=data-berge-os
JWT_AUDIENCE=data-berge-web
TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=db_session
CSRF_COOKIE_NAME=db_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
TRUST_PROXY_HEADERS=false
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# File/resource safety.
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BODY_BYTES=11534336
MAX_WORKBOOK_UNCOMPRESSED_BYTES=104857600
MAX_STORAGE_BYTES=104857600
REPORT_WORKERS=2
REPORT_QUEUE_CAPACITY=10
CONNECTOR_WORKERS=2
CONNECTOR_QUEUE_CAPACITY=6
OPENDOSM_MAX_ROWS=250000

# Optional. The deterministic analytics layer works without a model key.
# Provider default mode: use Agno's provider:model string and the provider's key.
AGNO_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=

# Generic OpenAI-compatible endpoint mode.
# If AGNO_BASE_URL is set, the app uses AGNO_API_KEY + AGNO_BASE_URL instead of
# provider-specific defaults. This works for local/OpenAI-compatible servers.
AGNO_API_KEY=
AGNO_BASE_URL=

# Optional MLflow observability for profiling and LLM/agent chat runs.
MLFLOW_TRACKING_ENABLED=false
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=Data-Berge OS
MLFLOW_LOG_PROMPT_INSTANCES=false
MLFLOW_PROMPT_VERSION=query-analyst-v1
MLFLOW_QUERY_ANALYST_PROMPT_NAME=query-analyst-planner
MLFLOW_QUERY_ANALYST_PROMPT_VERSION=1

# Separate secret used only to pseudonymize user IDs in observability systems.
# Generate a strong random value and keep it stable; never commit the real value.
OBSERVABILITY_ID_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=
