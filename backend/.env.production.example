APP_NAME=Data-Berge OS
APP_ENV=production
CORS_ALLOW_ORIGINS=https://app.example.com
ALLOWED_HOSTS=app.example.com,api.example.com
DATA_DIR=/data
LOCAL_CACHE_DIR_NAME=cache
DATABASE_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
AUTO_MIGRATE=false
RUN_STARTUP_RECONCILIATION=false

REDIS_URL=
QUEUE_MODE=redis

OBJECT_STORAGE_BACKEND=s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=data-berge

JWT_SECRET=
JWT_ISSUER=data-berge-os
JWT_AUDIENCE=data-berge-web
TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
TRUST_PROXY_HEADERS=true

AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BODY_BYTES=11534336
MAX_WORKBOOK_UNCOMPRESSED_BYTES=104857600
MAX_STORAGE_BYTES=104857600
REPORT_WORKERS=2
REPORT_QUEUE_CAPACITY=10
CONNECTOR_WORKERS=2
CONNECTOR_QUEUE_CAPACITY=6
OPENDOSM_MAX_ROWS=250000

AGNO_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
AGNO_API_KEY=
AGNO_BASE_URL=
AGNO_REQUEST_TIMEOUT_SECONDS=45
AGNO_MAX_RETRIES=1

MLFLOW_TRACKING_ENABLED=false
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=Data-Berge OS
MLFLOW_LOG_PROMPT_INSTANCES=false
OBSERVABILITY_ID_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=
